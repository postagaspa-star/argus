# Argus NAS - copia questo file in .env e scrivi i valori veri. Il file .env non va mai nel repo.
#
# Account della telecamera (non l'account TP-Link): app Tapo > la telecamera > Impostazioni >
# Impostazioni avanzate > Account della telecamera. Serve per RTSP (immagini) e ONVIF (movimento).
TAPO_UTENTE=
TAPO_CAMERA_IP=
TAPO_CAMERA_PASSWORD=
TAPO_SALOTTO_IP=
TAPO_SALOTTO_PASSWORD=

# Password dell'account TP-Link (quello dell'app Tapo): serve solo all'altoparlante delle Tapo,
# attraverso go2rtc (sorgente tapo://). Se resta vuota, le frasi le dice il PC.
TAPO_CLOUD_PASSWORD=

# Home Assistant (facoltativo): token di accesso a lunga durata, per spegnere le prese.
HA_TOKEN=

# Livello del registro del programma: INFO di solito, DEBUG per capire un problema.
ARGUS_LOG=INFO
